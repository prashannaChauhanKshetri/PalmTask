# ── OpenAI ──────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Pinecone ────────────────────────────────────────────
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX_NAME=palm-rag

# ── PostgreSQL ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://palm:palm@postgres:5432/palm

# ── Redis ───────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── RAG Tunables ────────────────────────────────────────
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.65
RAG_CONTEXTUAL_WINDOW=true

# ── Application ─────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=development
